{
  "expo": {
    "name": "Swipy",
    "slug": "keep-photo-cleaner",
    "scheme": "keep-prototype",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/keep-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.keep.photocleaner.prototype"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF8E8",
        "foregroundImage": "./assets/keep-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.keep.photocleaner.prototype"
    },
    "web": {
      "favicon": "./assets/keep-favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Swipy to help you review and clean up your photos.",
          "savePhotosPermission": "Allow Swipy to remove photos you confirm in the removal queue.",
          "granularPermissions": [
            "photo"
          ],
          "preventAutomaticLimitedAccessAlert": true
        }
      ],
      "expo-image",
      "expo-system-ui"
    ],
    "backgroundColor": "#FFF8E8"
  }
}
